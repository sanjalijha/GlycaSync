# GlycaSync environment — copy to .env
# The stack runs fully offline with rule-based fallbacks.
# Fill these only when you want live LLM / Sarvam / Twilio.

APP_NAME=GlycaSync
APP_ENV=demo
DATABASE_PATH=data/glycasync.db
DEBOUNCE_SECONDS=45
PUBLIC_BASE_URL=http://localhost:8000

# Optional: OpenAI-compatible Vision + chat (OpenAI, Groq, Azure, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini

# Optional: Sarvam AI — Saaras STT + Mayura translation
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Optional: Twilio WhatsApp
# PUBLIC_BASE_URL above must be the HTTPS address Twilio can reach, because the
# webhook signature is checked against it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=
# Only turn this off to replay captured payloads locally. The webhook writes to
# patient charts and can trigger an automatic emergency reply.
TWILIO_VALIDATE_SIGNATURE=true

# Care team display
CLINIC_NAME=GlycaSync Diabetes Clinic
CLINIC_CITY=Mumbai
